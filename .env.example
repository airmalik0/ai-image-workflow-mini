# Секретов в репозитории нет. Этот файл — список переменных, а не значений:
# `cp .env.example .env`, дальше заполнять по необходимости.
# Приложение обязано подниматься без единой заполненной строки — на fake-провайдере
# и локальном файловом хранилище.

# --- Провайдеры изображений ------------------------------------------------
# auto — первый доступный по порядку openai → gemini → fake. OpenAI впереди
# намеренно: он проверен вживую, а ключ Gemini может оказаться без баланса
IMAGE_PROVIDER=auto
GEMINI_API_KEY=
OPENAI_API_KEY=
# Ноды, на которых заглушка обязана падать, — список id через запятую. Нужен, чтобы
# воспроизвести сценарий «нода упала → Retry» без порчи боевого ключа. Работает только
# у fake; боевые провайдеры не трогает.
# `editImage-1` — падать всегда; `editImage-1:1` — падать только на первой попытке
# в каждом запуске, тогда Retry доводит ноду до успеха
FAKE_FAIL_NODES=

# --- HTTP-сервер ------------------------------------------------------------
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info
# Список источников через запятую; * — любой
CORS_ORIGIN=*
# Лимит загрузки изображения, байты. 15 МБ по умолчанию — фотография с телефона проходит
MAX_UPLOAD_BYTES=15728640
# Потолок оркестратора: сколько job'ов вообще уходит в исполнение одновременно
MAX_CONCURRENT_JOBS=4
# Потолок одного процесса-воркера: сколько job'ов он тянет параллельно
WORKER_CONCURRENCY=4

# --- Предохранитель демо-стенда --------------------------------------------
# Сколько успешных обращений к боевому провайдеру разрешено за сутки. 0 — без
# ограничения. Публичный стенд ходит в платный API по ключу владельца, поэтому
# ему нужен потолок: по исчерпании боевой провайдер заменяется на fake, признак
# появляется в GET /api/health, а в интерфейсе — плашка. Ошибка боевого
# провайдера остаётся ошибкой: подмена бывает только по квоте, никогда по сбою.
# Счётчик живёт в Redis и обнуляется в полночь UTC.
DEMO_DAILY_LIMIT=0

# --- Инфраструктура --------------------------------------------------------
# Значения ниже — для запуска без docker, руками. В `docker compose` адреса базы,
# Redis и каталога хранилища заданы самим compose (имена сервисов, общий том)
# и отсюда НЕ подхватываются: иначе `localhost` внутри контейнера указывал бы
# на сам контейнер. Всё остальное в этом файле compose честно подставляет.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/workflow
REDIS_URL=redis://localhost:6379

# --- Файловое хранилище ----------------------------------------------------
# fs (по умолчанию) — каталог на диске; s3 — любое S3-совместимое хранилище
STORAGE_DRIVER=fs
DATA_DIR=./data/files
# Публичная база адреса файлов. Пусто — файлы отдаёт сам API из /api/files
FILES_PUBLIC_BASE_URL=

# Заполняется только при STORAGE_DRIVER=s3
S3_BUCKET=
S3_REGION=ru-central1
S3_ENDPOINT=https://storage.yandexcloud.net
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# MinIO и локальные стенды понимают только path-style адреса
S3_FORCE_PATH_STYLE=false
S3_KEY_PREFIX=
S3_PUBLIC_BASE_URL=

# --- Порты docker compose ---------------------------------------------------
# Читаются только самим compose, в приложение не попадают. Меняются, если 3000
# или 3001 на машине уже заняты.
WEB_PORT=3000
API_PORT=3001

# --- Тесты -----------------------------------------------------------------
# Postgres для тестов репозиториев; порт нестандартный, чтобы не спорить с чужой базой
TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55432/workflow_test
# Redis для тестов очереди и шины событий; порт нестандартный по той же причине
TEST_REDIS_URL=redis://127.0.0.1:56379
# MinIO для тестов S3-адаптера
TEST_S3_ENDPOINT=http://127.0.0.1:55900
TEST_S3_ACCESS_KEY_ID=minioadmin
TEST_S3_SECRET_ACCESS_KEY=minioadmin
