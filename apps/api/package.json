{
  "name": "@workflow/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "clean": "rm -rf dist",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/cli.ts migrate",
    "db:seed": "tsx src/db/cli.ts seed",
    "db:setup": "tsx src/db/cli.ts setup"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1124.0",
    "@fastify/cors": "^11.3.0",
    "@fastify/multipart": "^10.1.1",
    "@fastify/swagger": "^9.8.1",
    "@fastify/swagger-ui": "^6.1.1",
    "@fastify/websocket": "^11.3.0",
    "@workflow/contracts": "workspace:*",
    "@workflow/core": "workspace:*",
    "bullmq": "^6.3.4",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.12.1",
    "fastify-type-provider-zod": "^7.0.0",
    "ioredis": "^6.0.0",
    "openapi-types": "^12.1.3",
    "pg": "^8.23.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.1",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.23.13"
  }
}
